@prefix event: <https://naples44.michelepasin.org/id/event/> .
@prefix folklore: <https://naples44.michelepasin.org/id/folklore/> .
@prefix id: <https://naples44.michelepasin.org/id/> .
@prefix person: <https://naples44.michelepasin.org/id/person/> .
@prefix place: <https://naples44.michelepasin.org/id/place/> .
@prefix reflection: <https://naples44.michelepasin.org/id/reflection/> .
