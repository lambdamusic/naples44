@prefix theme: <https://naples44.michelepasin.org/id/theme/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

id:dataset a schema:Dataset ;
    schema:about id:naples-44 ;
    schema:creator [ a schema:Person ;
            schema:name "Michele Pasin" ;
            schema:url <https://www.michelepasin.org> ] ;
    schema:dateModified "2026-09-02"^^xsd:date ;
    schema:description "A hand-built dataset of Norman Lewis's memoir Naples '44: its 108 dated diary entries, each with a paraphrased summary and tagged by theme, place, person and folklore motif, plus 20 broader events of the war."@en ;
    schema:isBasedOn id:naples-44 ;
    schema:name "Naples '44 — a structured reading" ;
    schema:url <https://naples44.michelepasin.org/> .

entry:1 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:war_violence ;
    schema:abstract "Aboard ship off Italy, news arrives of the armistice; Lewis notes the total lack of intelligence about what awaits them at Salerno."@en ;
    schema:contentLocation place:salerno ;
    schema:dateCreated "1943-09-08"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 8, 1943" ;
    schema:position 2 ;
    schema:url <https://naples44.michelepasin.org/entries/1/> .

entry:10 a schema:Chapter ;
    schema:about theme:allied_conduct,
        theme:war_violence ;
    schema:abstract "Reaching Salerno amid ongoing fighting, Lewis witnesses a brutal interrogation of an Italian civilian by a British officer."@en ;
    schema:contentLocation place:salerno ;
    schema:dateCreated "1943-09-20"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 20, 1943" ;
    schema:position 11 ;
    schema:url <https://naples44.michelepasin.org/entries/10/> .

entry:104 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:war_violence ;
    schema:abstract "Mob violence breaks out against local girls seen with Allied soldiers, and the section is controversially ordered to intervene with sub-machine guns."@en ;
    schema:contentLocation place:riviera-di-chiaia,
        place:santa-lucia-naples,
        place:villa-nazionale ;
    schema:dateCreated "1944-10-08"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 8, 1944" ;
    schema:position 105 ;
    schema:url <https://naples44.michelepasin.org/entries/104/> .

entry:105 a schema:Chapter ;
    schema:about theme:naples_character ;
    schema:abstract "A description of the Neapolitan tradition of autumn *ottobrate* family outings to gather chestnuts, mushrooms, and wild greens."@en ;
    schema:contentLocation place:lago-di-patria ;
    schema:dateCreated "1944-10-10"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "contact since the Anzio leak episode, hosts a family mushroom- and bird-hunting expedition"@en ;
            schema:mentions person:ingeniere-crespi ],
        person:ingeniere-crespi ;
    schema:name "October 10, 1944" ;
    schema:position 106 ;
    schema:url <https://naples44.michelepasin.org/entries/105/> .

entry:106 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:disease_health ;
    schema:abstract "A large-scale, coercive round-up of women for VD examinations follows a tip from a gynecologist contact, exposing the harsh methods used to fight the disease."@en ;
    schema:dateCreated "1944-10-16"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "helps set the trap that exposes the VD round-up operation"@en ;
            schema:mentions person:professore-placella ],
        person:professore-placella ;
    schema:name "October 16, 1944" ;
    schema:position 107 ;
    schema:url <https://naples44.michelepasin.org/entries/106/> .

entry:107 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:sex_relationships ;
    schema:abstract "Official policy strongly discourages marriages between soldiers and Italian civilians, citing poor historical outcomes for such wartime unions."@en ;
    schema:contentLocation place:capri,
        place:casoria,
        place:santa-lucia-naples,
        place:sorrento,
        place:via-aniello-falcone,
        place:via-calabritto,
        place:via-roma ;
    schema:dateCreated "1944-10-20"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 20, 1944" ;
    schema:position 108 ;
    schema:url <https://naples44.michelepasin.org/entries/107/> .

entry:11 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:personal_reflection ;
    schema:abstract "Ordered back to the idle beachhead life at Paestum despite its pointlessness; the section finally gets a small, real intelligence task that evening."@en ;
    schema:contentLocation place:castello-castelluccia,
        place:paestum,
        place:salerno ;
    schema:dateCreated "1943-09-21"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "tells the section their presence at Paestum serves no purpose"@en ;
            schema:mentions person:captain-cartwright ],
        person:captain-cartwright ;
    schema:name "September 21, 1943" ;
    schema:position 12 ;
    schema:url <https://naples44.michelepasin.org/entries/11/> .

entry:12 a schema:Chapter ;
    schema:about theme:allied_conduct,
        theme:disease_health,
        theme:war_violence ;
    schema:abstract "Hospitalized with malaria, Lewis hears disturbing accounts from wounded American soldiers about orders to kill surrendering Germans."@en ;
    schema:contentLocation place:paestum ;
    schema:dateCreated "1943-09-28"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 28, 1943" ;
    schema:position 13 ;
    schema:url <https://naples44.michelepasin.org/entries/12/> .

entry:13 a schema:Chapter ;
    schema:abstract "A violent storm collapses the hospital tent, flooding the ward and killing one patient."@en ;
    schema:dateCreated "1943-10-03"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 3, 1943" ;
    schema:position 14 ;
    schema:url <https://naples44.michelepasin.org/entries/13/> .

entry:14 a schema:Chapter ;
    schema:about theme:poverty_hunger,
        theme:sex_relationships,
        theme:war_violence ;
    schema:abstract "Discharged and hitching toward newly-liberated Naples, Lewis passes through Battipaglia, devastated by Allied carpet bombing, and learns nearby Altavilla was shelled to rubble on the mere suspicion it held Germans. Further on, he witnesses desperate Neapolitan housewives publicly exchanging sex for tins of rations with American soldiers."@en ;
    schema:contentLocation place:altavilla-silentina,
        place:battipaglia,
        place:paestum,
        place:portici,
        place:resina,
        place:salerno,
        place:sorrento,
        place:torre-annunziata ;
    schema:dateCreated "1943-10-04"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 4, 1943" ;
    schema:position 15 ;
    schema:url <https://naples44.michelepasin.org/entries/14/> .

entry:16 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:superstition_religion ;
    schema:abstract "Floods of dubious civilian tips overwhelm the section, including a \"spy\" who turns out to be rumored a witch by superstitious villagers."@en ;
    schema:contentLocation place:afragola ;
    schema:dateCreated "1943-10-08"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "local witch belief; villagers convinced a woman could curse the water supply"@en ;
            schema:mentions folklore:evil-eye ],
        folklore:evil-eye ;
    schema:name "October 8, 1943" ;
    schema:position 17 ;
    schema:url <https://naples44.michelepasin.org/entries/16/> .

entry:17 a schema:Chapter ;
    schema:about theme:poverty_hunger ;
    schema:abstract "Desperate Neapolitans scavenge limpets and offal for food, reflecting the extremity of the city's hunger."@en ;
    schema:contentLocation place:santa-lucia-naples ;
    schema:dateCreated "1943-10-09"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 9, 1943" ;
    schema:position 18 ;
    schema:url <https://naples44.michelepasin.org/entries/17/> .

entry:18 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:naples_character ;
    schema:abstract "Amid the grim work of processing denunciations, Lewis is struck by the vivid street life and rituals of a working-class Neapolitan neighborhood."@en ;
    schema:contentLocation place:rome ;
    schema:dateCreated "1943-10-10"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 10, 1943" ;
    schema:position 19 ;
    schema:url <https://naples44.michelepasin.org/entries/18/> .

entry:19 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity ;
    schema:abstract "A week of fruitless \"spy scares\" turns up only harmless eccentrics, while a new bureaucracy of mail and phone censorship intercepts trivia."@en ;
    schema:contentLocation place:san-gennaro-catacombs ;
    schema:dateCreated "1943-10-13"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "catacombs entered from behind his church"@en ;
            schema:mentions folklore:san-gennaro ],
        folklore:san-gennaro ;
    schema:name "October 13, 1943" ;
    schema:position 20 ;
    schema:url <https://naples44.michelepasin.org/entries/19/> .

entry:21 a schema:Chapter ;
    schema:about theme:war_violence ;
    schema:abstract "A motorcycle ride brings Lewis upon the horrifying aftermath of a sudden explosion, with bodies and dust coating a frozen, silent street scene."@en ;
    schema:contentLocation place:castel-nuovo,
        place:porta-capuana,
        place:via-partenope ;
    schema:dateCreated "1943-10-20"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 20, 1943" ;
    schema:position 22 ;
    schema:url <https://naples44.michelepasin.org/entries/21/> .

entry:22 a schema:Chapter ;
    schema:about theme:poverty_hunger,
        theme:war_violence ;
    schema:abstract "Amid ongoing famine, Lewis investigates an assault on a peasant family by deserters, and is later approached with a plea for help from one of the victims."@en ;
    schema:contentLocation place:aversa ;
    schema:dateCreated "1943-10-22"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 22, 1943" ;
    schema:position 23 ;
    schema:url <https://naples44.michelepasin.org/entries/22/> .

entry:25 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:poverty_hunger ;
    schema:abstract "Lewis reflects on the city's collapse into near-medieval conditions — makeshift clothing, scavenging, and looting of abandoned military equipment."@en ;
    schema:contentLocation place:filangieri-prison,
        place:posillipo-naples ;
    schema:dateCreated "1943-10-25"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "recently released from the Filangieri gaol, hosts the dinner where Lewis meets Lola"@en ;
            schema:mentions person:signora-gentile ],
        person:signora-gentile ;
    schema:name "October 25, 1943" ;
    schema:position 26 ;
    schema:url <https://naples44.michelepasin.org/entries/25/> .

entry:26 a schema:Chapter ;
    schema:about theme:poverty_hunger,
        theme:sex_relationships ;
    schema:abstract "Asked to interpret between an Italian woman and her English-speaking-impaired British officer lover, Lewis observes how bread and supplies shape wartime romance."@en ;
    schema:contentLocation place:questura-naples-police-hq ;
    schema:dateCreated "1943-10-28"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "invoked as patron of coitus reservatus"@en ;
            schema:mentions folklore:san-rocco ],
        [ a schema:Role ;
            schema:description "Frazer's lover, met at Signora Gentile's dinner party; asks Lewis to interpret for the relationship"@en ;
            schema:mentions person:signora-lola ],
        [ a schema:Role ;
            schema:description "RASC captain, Lola's lover; Lewis interprets for the couple"@en ;
            schema:mentions person:captain-frazer ],
        folklore:san-rocco,
        person:captain-frazer,
        person:signora-lola ;
    schema:name "October 28, 1943" ;
    schema:position 27 ;
    schema:url <https://naples44.michelepasin.org/entries/26/> .

entry:29 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:sex_relationships ;
    schema:abstract "A Neapolitan prince and his sister calmly request that she be admitted to a (nonexistent) army brothel, illustrating the era's blunt attitudes to sex and survival."@en ;
    schema:contentLocation place:riviera-di-chiaia ;
    schema:dateCreated "1943-11-10"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "gynaecologist specialising in the restoration of virginity, one of Parkinson's medical contacts"@en ;
            schema:mentions person:professore-placella ],
        [ a schema:Role ;
            schema:description "enthusiastic informant, absentee landlord and head of a leading noble family"@en ;
            schema:mentions person:prince-a ],
        [ a schema:Role ;
            schema:description "the Prince's sister, for whom he requests entry to a nonexistent army brothel"@en ;
            schema:mentions person:luisa ],
        person:luisa,
        person:prince-a,
        person:professore-placella ;
    schema:name "November 10, 1943" ;
    schema:position 30 ;
    schema:url <https://naples44.michelepasin.org/entries/29/> .

entry:3 a schema:Chapter ;
    schema:about theme:allied_conduct,
        theme:war_violence ;
    schema:abstract "A strafing run and near-miss becomes almost routine; Lewis contrasts his own hardened nerves with the panic of green American troops."@en ;
    schema:dateCreated "1943-09-10"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 10, 1943" ;
    schema:position 4 ;
    schema:url <https://naples44.michelepasin.org/entries/3/> .

entry:30 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:poverty_hunger ;
    schema:abstract "Lattarullo hosts an elaborate lunch cobbled together from borrowed furniture and his one prized heirloom, despite having almost nothing."@en ;
    schema:contentLocation place:sicily,
        place:via-san-felice ;
    schema:dateCreated "1943-11-15"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "hosts an elaborate lunch cobbled together from borrowed furniture and one prized heirloom salver"@en ;
            schema:mentions person:vincente-lattarullo ],
        person:vincente-lattarullo ;
    schema:name "November 15, 1943" ;
    schema:position 31 ;
    schema:url <https://naples44.michelepasin.org/entries/30/> .

entry:31 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:poverty_hunger ;
    schema:abstract "Wartime hunger drives extreme culinary improvisation, including eating storks and rumors of a manatee served at a banquet for General Clark."@en ;
    schema:contentLocation place:nola,
        place:vesuvius ;
    schema:dateCreated "1943-11-25"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "a widespread superstitious aversion to harming storks; a village that ate its storks' nestlings during famine is regarded as having brought calamity on itself"@en ;
            schema:mentions folklore:stork-veneration ],
        folklore:stork-veneration ;
    schema:name "November 25, 1943" ;
    schema:position 32 ;
    schema:url <https://naples44.michelepasin.org/entries/31/> .

entry:32 a schema:Chapter ;
    schema:about theme:black_market,
        theme:disease_health ;
    schema:abstract "Restaurants reopen with black-market prices; Lewis catches up with Captain Frazer, whose health and mood have visibly declined."@en ;
    schema:dateCreated "1943-11-26"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "found gaunt and wasted, eating sea urchins on medical advice related to his relationship with Lola"@en ;
            schema:mentions person:captain-frazer ],
        person:captain-frazer ;
    schema:name "November 26, 1943" ;
    schema:position 33 ;
    schema:url <https://naples44.michelepasin.org/entries/32/> .

entry:33 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:crime_banditry ;
    schema:abstract "Lewis avoids an unwanted arrest by spending the day on unrelated errands, reflecting on the unit's discomfort with being used for private vendettas."@en ;
    schema:contentLocation place:acerra,
        place:afragola,
        place:casoria,
        place:filangieri-prison ;
    schema:dateCreated "1943-12-05"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "hired mourners attend funerals to perform grief, reinforcing the family's display of loss"@en ;
            schema:mentions folklore:professional-wailers ],
        folklore:professional-wailers ;
    schema:name "December 5, 1943" ;
    schema:position 34 ;
    schema:url <https://naples44.michelepasin.org/entries/33/> .

entry:35 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:crime_banditry ;
    schema:abstract "Lewis describes how gullible unit commanders and their local interpreters get dragged into baseless denunciations and village feuds, including against a corrupt police marshal."@en ;
    schema:contentLocation place:afragola,
        place:aversa,
        place:sicily,
        place:torrito ;
    schema:dateCreated "1943-12-18"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "December 18, 1943" ;
    schema:position 36 ;
    schema:url <https://naples44.michelepasin.org/entries/35/> .

entry:36 a schema:Chapter ;
    schema:about theme:crime_banditry,
        theme:war_violence ;
    schema:abstract "Investigating a wartime denunciation case, Lewis interviews an informer with a criminal record about his role in betraying escaped Indian soldiers to the Germans."@en ;
    schema:contentLocation place:caivano,
        place:questura-naples-police-hq,
        place:torrito,
        place:zona-di-camorra ;
    schema:dateCreated "1943-12-20"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "bandit near Torrito, killed in a locally-arranged reprisal for looting rather than political resistance"@en ;
            schema:mentions person:albano ],
        person:albano ;
    schema:name "December 20, 1943" ;
    schema:position 37 ;
    schema:url <https://naples44.michelepasin.org/entries/36/> .

entry:39 a schema:Chapter ;
    schema:about theme:crime_banditry,
        theme:naples_character ;
    schema:abstract "A visit to Donna Maria \"La Pitonessa,\" a former circus performer turned wealthy landowner, in the Camorra zone."@en ;
    schema:contentLocation place:caivano,
        place:zona-di-camorra ;
    schema:dateCreated "1944-01-07"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "wealthy landowner near Caivano, former circus python-wrestler; not Camorra herself (women excluded) but a valuable informant"@en ;
            schema:mentions person:donna-maria-fidora-la-pitonessa ],
        person:donna-maria-fidora-la-pitonessa ;
    schema:name "January 7, 1944" ;
    schema:position 40 ;
    schema:url <https://naples44.michelepasin.org/entries/39/> .

entry:4 a schema:Chapter ;
    schema:about theme:personal_reflection,
        theme:war_violence ;
    schema:abstract "HQ moves to a tranquil rural setting, but there's a creeping sense that the Fifth Army is unprepared and undefended."@en ;
    schema:contentLocation place:albanella,
        place:pompeii,
        place:sele-river ;
    schema:dateCreated "1943-09-11"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "tinsel from her mantle believed to grant protection/bulletproofing"@en ;
            schema:mentions folklore:madonna-of-pompeii ],
        folklore:madonna-of-pompeii ;
    schema:name "September 11, 1943" ;
    schema:position 5 ;
    schema:url <https://naples44.michelepasin.org/entries/4/> .

entry:40 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:poverty_hunger ;
    schema:abstract "The wire-theft crackdown continues to unfairly target small, desperate offenders like an elderly scrap-merchant, while real traders go untouched."@en ;
    schema:contentLocation place:afragola,
        place:poggio-reale-prison ;
    schema:dateCreated "1944-01-12"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "January 12, 1944" ;
    schema:position 41 ;
    schema:url <https://naples44.michelepasin.org/entries/40/> .

entry:41 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:war_violence ;
    schema:abstract "Amid a flood of usually-worthless rumors, one turns out to be true — an imminent Anzio landing — sending Lewis scrambling to trace a security leak."@en ;
    schema:contentLocation place:matlock,
        place:rome,
        place:via-filippo-palizzi,
        place:vomero-naples ;
    schema:dateCreated "1944-01-14"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "Norah's husband, part of the friendship network Lewis values"@en ;
            schema:mentions person:alberto-gemelli ],
        [ a schema:Role ;
            schema:description "half-Italian, half-Irish friend whose information about the Anzio leak Lewis is forced to pursue"@en ;
            schema:mentions person:norah-gemelli ],
        person:alberto-gemelli,
        person:norah-gemelli ;
    schema:name "January 14, 1944" ;
    schema:position 42 ;
    schema:url <https://naples44.michelepasin.org/entries/41/> .

entry:42 a schema:Chapter ;
    schema:about theme:black_market,
        theme:bureaucracy_absurdity ;
    schema:abstract "Chaotic, arbitrary court proceedings at Castel Capuano illustrate the absurd unevenness of wartime justice, set against an open black market."@en ;
    schema:contentLocation place:castel-capuano,
        place:porta-capuana ;
    schema:dateCreated "1944-01-19"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "January 19, 1944" ;
    schema:position 43 ;
    schema:url <https://naples44.michelepasin.org/entries/42/> .

entry:43 a schema:Chapter ;
    schema:about theme:war_violence ;
    schema:abstract "The Anzio landing succeeds, seemingly aided by German unpreparedness — underscored by discarded operational maps found being burned by locals for fuel."@en ;
    schema:contentLocation place:torre-annunziata ;
    schema:dateCreated "1944-01-22"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "January 22, 1944" ;
    schema:position 44 ;
    schema:url <https://naples44.michelepasin.org/entries/43/> .

entry:44 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:crime_banditry ;
    schema:abstract "Thieves brazenly strip the wheels from vehicles at the supposedly secure Field Security Headquarters, showcasing local audacity and ingenuity."@en ;
    schema:contentLocation place:agropoli,
        place:castellammare-di-stabia,
        place:porta-capuana,
        place:san-carlo-opera-house ;
    schema:dateCreated "1944-02-05"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "February 5, 1944" ;
    schema:position 45 ;
    schema:url <https://naples44.michelepasin.org/entries/44/> .

entry:47 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:disease_health,
        theme:sex_relationships ;
    schema:abstract "An account of a bizarre, catastrophic Allied intelligence scheme prompted by fears that prostitution was being used to spread disease among troops."@en ;
    schema:contentLocation place:capri,
        place:rome,
        place:sorrento,
        place:vomero-naples ;
    schema:dateCreated "1944-03-03"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "March 3, 1944" ;
    schema:position 48 ;
    schema:url <https://naples44.michelepasin.org/entries/47/> .

entry:48 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:war_violence ;
    schema:abstract "The growing, increasingly careless traffic of \"line-crossers\" and letter-couriers moving between Allied and German territory raises serious security concerns."@en ;
    schema:contentLocation place:cafe-savoia,
        place:piazza-dante,
        place:rome,
