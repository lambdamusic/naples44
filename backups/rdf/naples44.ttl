            schema:latitude 40.8506445 ;
            schema:longitude 14.2631849 ] ;
    schema:name "Via Forcella" ;
    schema:url <https://naples44.michelepasin.org/places/via-forcella/> .

place:villa-nazionale a schema:Place ;
    schema:additionalType "Landmark" ;
    schema:disambiguatingDescription "The seafront park on the Riviera di Chiaia — a backdrop for Sunday crowds, the arrival of spring, and later the mob attacks on women seen with Allied soldiers."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8394208 ;
            schema:longitude 14.2301005 ] ;
    schema:name "Villa Nazionale" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Villa_Comunale,_Naples> ;
    schema:url <https://naples44.michelepasin.org/places/villa-nazionale/> .

folklore:monte-vergine a schema:DefinedTerm ;
    schema:description "Sanctuary of Montevergine is a Marian church in Mercogliano, located in the hamlet of Montevergine. It's a part of the Territorial Abbey of Montevergine, one of the six Italian territorial abbeys. Inside, the painting of the Madonna di Montevergine is venerated and it is estimated that about one and a half million pilgrims visit it every year."@en ;
    schema:disambiguatingDescription "The mountain sanctuary of the Virgin above Avellino, on the site of an ancient shrine of Cybele; the banning of its 1944 Whitsun pilgrimage causes widespread public dismay, and its district furnishes Lattarullo with a lurid tale of fake clergy fleecing a woman black-marketeer."@en ;
    schema:inDefinedTermSet id:folklore ;
    schema:name "Monte Vergine" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Sanctuary_of_Montevergine> ;
    schema:url <https://naples44.michelepasin.org/folklore/monte-vergine/> .

person:bernard-durham a schema:Person ;
    schema:additionalType "Allied colleague" ;
    schema:description "A sergeant in Lewis's Field Security section, one of only four left to cover Naples itself."@en ;
    schema:disambiguatingDescription "Among the handful of section men — with Parkinson, Evans and Lewis — holding the city after the rest were dispersed to the coast and to Nola. Later shot through the shoulder by a bandit dressed as an American officer during an anti-bandit drive near Avellino — the section's first casualty."@en ;
    schema:name "Bernard Durham" ;
    schema:url <https://naples44.michelepasin.org/people/bernard-durham/> .

person:captain-cartwright a schema:Person ;
    schema:additionalType "Allied colleague" ;
    schema:description "The section's Field Security Officer."@en ;
    schema:disambiguatingDescription "Smashed up in a car crash the day before embarkation and left in hospital in Oran, so the section lands in Italy leaderless; when he finally reaches them, his face 'covered with plaster', it is to admit that their presence at Paestum serves 'no purpose of any kind'."@en ;
    schema:name "Captain Cartwright" ;
    schema:url <https://naples44.michelepasin.org/people/captain-cartwright/> .

person:carlo-del-giudice a schema:Person ;
    schema:additionalType "Informant / contact" ;
    schema:description "A non-practising Naples lawyer scraping a living writing newspaper articles on folklore and astronomy, and an expert on San Gennaro and Vesuvius."@en ;
    schema:disambiguatingDescription "Introduced by Lattarullo during the 1944 eruption; he quizzes Lewis about the threatened towns, supplies much of the book's San Gennaro lore, and later joins the parade of eccentric visitors to Lewis's hospital bed."@en ;
    schema:name "Carlo Del Giudice" ;
    schema:url <https://naples44.michelepasin.org/people/carlo-del-giudice/> .

person:domenico-lupo-wolf a schema:Person ;
    schema:additionalType "Camorrista / bandit" ;
    schema:description "A young, handsome, dashing bandit of Frattamaggiore — robber of the rich and giver to the poor."@en ;
    schema:disambiguatingDescription "Freed from prison by the advancing Allies, he rebuilds his band with a forged AMG travel pass; Lewis watches, as an onlooker, the police operation that finally takes him, sprung by his jealous mistress."@en ;
    schema:name "Domenico 'Lupo' (Wolf)" ;
    schema:url <https://naples44.michelepasin.org/people/domenico-lupo-wolf/> .

person:don-ubaldo a schema:Person ;
    schema:additionalType "Civilian friend" ;
    schema:description "The schoolmaster of the Benevento town, nominally on the rolls of a left-wing party."@en ;
    schema:disambiguatingDescription "Gives Lewis the long historical view of Southern Italian banditry — that the bands surface whenever order collapses and attach themselves to the landowners. He dies of typhoid, and the section moves on to Sagranella."@en ;
    schema:name "Don Ubaldo" ;
    schema:url <https://naples44.michelepasin.org/people/don-ubaldo/> .

person:donna-maria-fidora-la-pitonessa a schema:Person ;
    schema:additionalType "Informant / contact" ;
    schema:description "The richest landowner near Caivano, a former circus performer who had wrestled a python — hence 'La Pitonessa'."@en ;
    schema:disambiguatingDescription "Lewis's first contact inside the Camorra zone outside the police; barred as a woman from the Camorra itself but a valuable informant, she runs her late husband's estate with professional efficiency and turns up, incongruously, at Lewis's hospital bedside."@en ;
    schema:name "Donna Maria Fidora ('La Pitonessa')" ;
    schema:url <https://naples44.michelepasin.org/people/donna-maria-fidora-la-pitonessa/> .

person:eric-williams a schema:Person ;
    schema:additionalType "Allied colleague" ;
    schema:description "The section's best Italian speaker."@en ;
    schema:disambiguatingDescription "Sent as 'a solitary exile' to run security in Nola, where the Feast of the Lily brings the town — and the army's telephone lines — to a standstill; his complaints supply one of the book's set-piece feast stories."@en ;
    schema:name "Eric Williams" ;
    schema:url <https://naples44.michelepasin.org/people/eric-williams/> .

person:marshal-altamura a schema:Person ;
    schema:additionalType "Police official" ;
    schema:description "The SIM secret-police officer who effectively runs Benevento — 'handsome, good-humoured, quite imperturbable' and exuding 'sinister power'."@en ;
    schema:disambiguatingDescription "Ordered by Naples to place himself at Lewis's disposal, he stage-manages Lewis's introduction to the town's notables; but an anonymous letter, and the wounding of Durham, leave Lewis increasingly uneasy that the Marshal is in league with the bandits."@en ;
    schema:name "Marshal Altamura" ;
    schema:url <https://naples44.michelepasin.org/people/marshal-altamura/> .

person:moore a schema:Person ;
    schema:additionalType "Allied colleague" ;
    schema:description "One of the section's sergeants."@en ;
    schema:disambiguatingDescription "Makes a hair-raising twelve-mile jeep dash out of the Salerno battle to rejoin the section; a year later he is 'working on with unabated vigour' despite hepatitis — part of the section's slow grinding-down by illness."@en ;
    schema:name "Moore" ;
    schema:url <https://naples44.michelepasin.org/people/moore/> .

person:professore-placella a schema:Person ;
    schema:additionalType "Informant / contact" ;
    schema:description "A Naples gynaecologist whose speciality is the surgical restoration of virginity — his replacement, he boasts, is better than the original."@en ;
    schema:disambiguatingDescription "Parkinson's most valuable medical contact; he helps expose the hospital racket by which syphilitic prostitutes bought clean bills of health, and later helps spring the trap on the coercive VD round-up."@en ;
    schema:name "Professore Placella" ;
    schema:url <https://naples44.michelepasin.org/people/professore-placella/> .

person:sergeant-major-john-dashwood a schema:Person ;
    schema:additionalType "Allied colleague" ;
    schema:description "The section's warrant officer."@en ;
    schema:disambiguatingDescription "In the confusion after the landing, sends four of the section by motorcycle along the shore to Salerno in the hope of finding the Field Security Officer and an order releasing them from their 'absurd predicament'. Runs the section through those leaderless first weeks, and is later the bearer of unwelcome HQ news — including the cut to informant funds."@en ;
    schema:name "Sergeant-Major (John) Dashwood" ;
    schema:url <https://naples44.michelepasin.org/people/sergeant-major-john-dashwood/> .

person:vito-genovese a schema:Person ;
    schema:additionalType "Camorrista / bandit" ;
    schema:description "Vito Genovese was an Italian-born American mafioso and the boss of the Genovese crime family of New York City. A childhood friend and criminal associate of Lucky Luciano, Genovese took part in the Castellammarese War and helped Luciano shape the Mafia's rise as a major force in organized crime in the United States. He would later lead Luciano's crime family, which was renamed by the FBI after Genovese in 1957."@en ;
    schema:disambiguatingDescription "Born near Naples, the exiled American mafia boss has taken a job as an AMG interpreter and manoeuvred himself into 'unassailable power' in the military government; the new mayors of the Camorra-zone towns are said to be his nominees, and the black market runs under his protection."@en ;
    schema:name "Vito Genovese" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Vito_Genovese> ;
    schema:url <https://naples44.michelepasin.org/people/vito-genovese/> .

place:avellino a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Avellino is a city and comune (municipality), and capital of the province of Avellino in the region of Campania in southern Italy. It is situated in a plain surrounded by mountains 47 kilometres (29 mi) east of Naples and is an important hub on the road from Salerno to Benevento. It has 51,819 inhabitants."@en ;
    schema:disambiguatingDescription "An inland town on the roads Lewis travels, appearing around the September 1943 fighting and again during the 1944 bandit troubles."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.91666667 ;
            schema:longitude 14.78888889 ] ;
    schema:name "Avellino" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Avellino> ;
    schema:url <https://naples44.michelepasin.org/places/avellino/> .

place:aversa a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Aversa is a city and comune in the Province of Caserta in Campania, southern Italy, about 24 km north of Naples. It is the centre of an agricultural district, the Agro Aversano, producing wine and cheese. Aversa is also the main seat of the faculties of Architecture and Engineering of the Università degli studi della Campania \"L."@en ;
    schema:disambiguatingDescription "One of the towns north of Naples in Lewis's patch, recurring with famine-driven crime, impoverished nobility and village denunciations."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.96666667 ;
            schema:longitude 14.2 ] ;
    schema:name "Aversa" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Aversa> ;
    schema:url <https://naples44.michelepasin.org/places/aversa/> .

place:forcella-market-district a schema:Place ;
    schema:additionalType "District" ;
    schema:disambiguatingDescription "The market quarter synonymous with the black market — stolen Allied goods sold openly, almost elegantly, a short walk from the courts trying petty thieves."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8503 ;
            schema:longitude 14.2622 ] ;
    schema:name "Forcella (market district)" ;
    schema:url <https://naples44.michelepasin.org/places/forcella-market-district/> .

place:hotel-vesuvio-benevento a schema:Place ;
    schema:additionalType "Landmark" ;
    schema:disambiguatingDescription "The damaged, stripped-out hotel where Lewis lodges during the Benevento posting."@en ;
    schema:name "Hotel Vesuvio (Benevento)" ;
    schema:url <https://naples44.michelepasin.org/places/hotel-vesuvio-benevento/> .

place:piazza-dante a schema:Place ;
    schema:additionalType "Piazza" ;
    schema:description "Piazza Dante is a large public square in Naples, Italy, named after the medieval poet Dante Alighieri. The square is dominated by a 19th-century statue of Dante, sculpted by Tito Angelini."@en ;
    schema:disambiguatingDescription "The square at the top of the Via Roma that Lewis uses to measure the city's mental distance from the countryside — its cafés are ten miles and a thousand years from the Bronze-Age world of Afragola. Its Café Savoia is a haunt of line-crossers, and an old woman stops him near here trying to sell her daughter."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.84901667 ;
            schema:longitude 14.25007222 ] ;
    schema:name "Piazza Dante" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Piazza_Dante,_Naples> ;
    schema:url <https://naples44.michelepasin.org/places/piazza-dante/> .

place:altamura a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Altamura is a town and comune of Apulia, in southern Italy. It is located on one of the hills of the Murge plateau in the Metropolitan City of Bari, 45 kilometres southwest of Bari, close to the border with Basilicata. As of 2017, it has a population to 70,595."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.6364944 ;
            schema:longitude 14.9124284 ] ;
    schema:name "Altamura" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Altamura> ;
    schema:url <https://naples44.michelepasin.org/places/altamura/> .

place:caivano a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Caivano is a comune (municipality) in the Metropolitan City of Naples in the Italian region Campania, located about 14 km (8.7 mi) northeast of Naples."@en ;
    schema:disambiguatingDescription "One of the Camorra-zone towns north of Naples in Lewis's security patch, recurring with denunciation cases, the eccentric landowner ‘La Pitonessa’, and the bandit ‘Lupo’."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.957112 ;
            schema:longitude 14.31023 ] ;
    schema:name "Caivano" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Caivano> ;
    schema:url <https://naples44.michelepasin.org/places/caivano/> .

place:casoria a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Casoria is a city and comune (municipality) in the Metropolitan City of Naples in the region of Campania in southern Italy, located about 5 kilometres northeast of Naples. It has 73,257 inhabitants."@en ;
    schema:disambiguatingDescription "Another of the poor towns north of Naples that Lewis polices, tied to the fruitless wire-theft investigation and the wider Camorra-country cases."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.9045572 ;
            schema:longitude 14.2901223 ] ;
    schema:name "Casoria" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Casoria> ;
    schema:url <https://naples44.michelepasin.org/places/casoria/> .

place:nola a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Nola is a city and comune in the Metropolitan City of Naples, Campania, southern Italy. It lies on the plain between Mount Vesuvius and the Apennines. It is traditionally credited as the diocese that introduced bells to Christian worship."@en ;
    schema:disambiguatingDescription "Appears mainly through its Feast of the Lily, whose towering ceremonial structures and procession foul the army's telephone lines — one of the book's set-piece collisions between folk ritual and the occupying army."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.92611111 ;
            schema:longitude 14.5275 ] ;
    schema:name "Nola" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Nola> ;
    schema:url <https://naples44.michelepasin.org/places/nola/> .

place:paestum a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Paestum was a major ancient Greek city on the coast of the Tyrrhenian Sea, in Magna Graecia. The ruins of Paestum are famous for their three ancient Greek temples in the Doric order dating from about 550 to 450 BCE that are in an excellent state of preservation. The city walls and amphitheatre are largely intact, and the bottom of the walls of many other structures remain, as well as paved roads."@en ;
    schema:disambiguatingDescription "The Greek temples beside the landing beach, where the leaderless section spends its first rudderless days in Italy amid dead soldiers, and later the pointless idle life of the beachhead."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.42222222 ;
            schema:longitude 15.00527778 ] ;
    schema:name "Paestum" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Paestum> ;
    schema:url <https://naples44.michelepasin.org/places/paestum/> .

place:riviera-di-chiaia a schema:Place ;
    schema:additionalType "Street" ;
    schema:description "The Riviera di Chiaia is a long street in the Italian city of Naples, running along the coast of the Gulf of Naples."@en ;
    schema:disambiguatingDescription "The seafront street where the section takes over a grand requisitioned palazzo. Lewis's Sunday observations here — aristocratic grandeur mixed with teeming working-class street life — are among the book's fondest passages."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.83361111 ;
            schema:longitude 14.23361111 ] ;
    schema:name "Riviera di Chiaia" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Riviera_di_Chiaia> ;
    schema:url <https://naples44.michelepasin.org/places/riviera-di-chiaia/> .

place:santa-lucia-naples a schema:Place ;
    schema:additionalType "District" ;
    schema:disambiguatingDescription "The old waterfront district, seen at its most desperate (people scavenging limpets and offal) and its most devastated, when Lewis walks through the aftermath of a bombing raid among dead children and grieving families."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8283 ;
            schema:longitude 14.2477 ] ;
    schema:name "Santa Lucia (Naples)" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Santa_Lucia,_Naples> ;
    schema:url <https://naples44.michelepasin.org/places/santa-lucia-naples/> .

place:via-roma a schema:Place ;
    schema:additionalType "Street" ;
    schema:description "Via Toledo is an ancient street and one of the most important shopping thoroughfares in the city of Naples, Italy. The street is almost 1.2 kilometres (0.75 mi) long and starts at Piazza Dante and ends in Piazza Trieste e Trento, near Piazza del Plebiscito."@en ;
    schema:disambiguatingDescription "Naples's main thoroughfare, backdrop to street scenes of the black market trading openly and, at its bleakest, a mother trying to sell her daughter."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.84555556 ;
            schema:longitude 14.24916667 ] ;
    schema:name "Via Roma" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Via_Toledo> ;
    schema:url <https://naples44.michelepasin.org/places/via-roma/> .

place:vomero-naples a schema:Place ;
    schema:additionalType "District" ;
    schema:description "Vomero is a hilltop quarter of Naples, Italy — comprising approximately two square kilometres (0.77 sq mi) and a population of 48,000."@en ;
    schema:disambiguatingDescription "The hilltop quarter, associated with the section's informant network and with several intelligence flaps — the false-mine mass evacuation, the traced Anzio leak."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.83333333 ;
            schema:longitude 14.23333333 ] ;
    schema:name "Vomero (Naples)" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Vomero> ;
    schema:url <https://naples44.michelepasin.org/places/vomero-naples/> .

folklore:evil-eye a schema:DefinedTerm ;
    schema:description "The evil eye is a supernatural belief in a curse brought about by a malevolent glare, usually inspired by envy. Amulets to protect against it have been found dating to around 5,000 years ago. It is found in many cultures in the Mediterranean region, the Balkans, Eastern Europe, West Asia, Central Asia, South Asia, Africa, the Caribbean, and Latin America, with such cultures often believing that receiving the evil eye will cause misfortune or injury, while others believe it to be a kind of supernatural force that casts or reflects a malevolent gaze back upon those who wish harm upon others."@en ;
    schema:disambiguatingDescription "The pervasive Neapolitan dread of the malevolent glance — coral-horn amulets in every jeweller's window, a Via Carducci block shunned as cursed, a woman blamed for poisoning a village water supply — and, by September 1944, the Benevento notables making protective gestures at Lewis himself, taking him for a jettatore."@en ;
    schema:inDefinedTermSet id:folklore ;
    schema:name "evil eye" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Evil_eye> ;
    schema:url <https://naples44.michelepasin.org/folklore/evil-eye/> .

person:susanna a schema:Person ;
    schema:additionalType "Companion" ;
    schema:description "Lola's friend — 'a frisky redhead of about twenty-five' with an unusually expressive mime."@en ;
    schema:disambiguatingDescription "A fixture of the Frazer–Lola circle, from the Capri outing to the dinner in the looted flat, where she memorably calls a drunk, boorish British adjutant a cornuto and a stronzo to his uncomprehending face."@en ;
    schema:name "Susanna" ;
    schema:url <https://naples44.michelepasin.org/people/susanna/> .

place:vesuvius a schema:Place ;
    schema:additionalType "Natural feature" ;
    schema:description "Mount Vesuvius is a somma–stratovolcano located on the Gulf of Naples in Campania, Italy, about 9 km (5.6 mi) east of Naples and a short distance from the shore. It is one of several volcanoes forming the Campanian volcanic arc. Vesuvius consists of a large cone partially encircled by the steep rim of a summit caldera, resulting from the collapse of an earlier, much higher structure."@en ;
    schema:disambiguatingDescription "Dominates March 1944, when the volcano erupts spectacularly — Lewis reaches for Pliny's account of Pompeii — burying nearby towns in ash while he consults seismologists about the risk to military installations."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.82138889 ;
            schema:longitude 14.42611111 ] ;
    schema:name "Vesuvius" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Mount_Vesuvius> ;
    schema:url <https://naples44.michelepasin.org/places/vesuvius/> .

place:zona-di-camorra a schema:Place ;
    schema:additionalType "Region" ;
    schema:disambiguatingDescription "Lewis's own name for the belt of towns north of Naples he is given to police: ‘unknowingly located deep in Camorra territory’, picturesque on the surface, poor and criminally governed underneath."@en ;
    schema:name "Zona di Camorra" ;
    schema:url <https://naples44.michelepasin.org/places/zona-di-camorra/> .

place:sorrento a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Sorrento, officially Comune di Sorrento is a city and comune overlooking the Bay of Naples in Southern Italy. A popular tourist destination, Sorrento is located on the Sorrentine Peninsula at the southern terminus of a main branch of the Circumvesuviana rail network, within easy access from Naples and Pompei. The city is widely known for its small ceramics, lacework and marquetry (woodwork) shops."@en ;
    schema:disambiguatingDescription "One of the Bay towns at the edge of Lewis's world, passed through on the way to and from Naples and associated with the more comfortable, touristic side of the coast."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.624906 ;
            schema:longitude 14.374836 ] ;
    schema:name "Sorrento" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Sorrento> ;
    schema:url <https://naples44.michelepasin.org/places/sorrento/> .

theme:allied_conduct a schema:DefinedTerm ;
    schema:description "Behavior/attitudes of Allied troops toward locals"@en ;
    schema:inDefinedTermSet id:themes ;
    schema:name "Allied conduct" ;
    schema:url <https://naples44.michelepasin.org/themes/allied_conduct/> .

place:capri a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Capri is an island located in the Tyrrhenian Sea off the Sorrento Peninsula, on the south side of the Gulf of Naples in the Campania region of Italy. A resort destination since the time of the Roman Republic, it is known for its natural beauty, historic sites, and tourism industry. It has 13,451 inhabitants."@en ;
    schema:disambiguatingDescription "The island escape — a golden, carefree boat trip with Captain Frazer and Lola stands out sharply against the war, and the island reappears through Frazer's turbulent romance."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.55 ;
            schema:longitude 14.23333333 ] ;
    schema:name "Capri" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Capri> ;
    schema:url <https://naples44.michelepasin.org/places/capri/> .

place:poggio-reale-prison a schema:Place ;
    schema:additionalType "Landmark" ;
    schema:disambiguatingDescription "The prison and its courts, where Lewis's cases keep ending up — a German held over the mine hoax, the well-connected racketeer Fortuna expecting acquittal, petty thieves tried within sight of an open black market. It embodies the book's sense of justice falling only on the powerless."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8583 ;
            schema:longitude 14.2856 ] ;
    schema:name "Poggio Reale prison" ;
    schema:url <https://naples44.michelepasin.org/places/poggio-reale-prison/> .

place:sicily a schema:Place ;
    schema:additionalType "Region" ;
    schema:description "Sicily, officially the Sicilian Region, is an island in the central Mediterranean Sea and one of the twenty regions of Italy, situated south of the Italian Peninsula in continental Europe. With over 4.7 million inhabitants, including 1.2 million in and around the capital city of Palermo, it is both the largest and most populous island in the Mediterranean Sea."@en ;
    schema:disambiguatingDescription "Referred to as the campaign's starting point and, more often, as shorthand for the deep-rooted world of Southern Italian banditry, landowners and assimilation that Lewis keeps coming up against."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 37.5 ;
            schema:longitude 14.0 ] ;
    schema:name "Sicily" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Sicily> ;
    schema:url <https://naples44.michelepasin.org/places/sicily/> .

theme:black_market a schema:DefinedTerm ;
    schema:description "Smuggling, theft of Allied goods, corruption, racketeering"@en ;
    schema:inDefinedTermSet id:themes ;
    schema:name "Black market" ;
    schema:url <https://naples44.michelepasin.org/themes/black_market/> .

theme:superstition_religion a schema:DefinedTerm ;
    schema:description "Miracles, saints, folk magic, the evil eye, ritual"@en ;
    schema:inDefinedTermSet id:themes ;
    schema:name "Superstition & religion" ;
    schema:url <https://naples44.michelepasin.org/themes/superstition_religion/> .

person:signora-lola a schema:Person ;
    schema:additionalType "Companion" ;
    schema:description "A war widow, once the mistress of a Fascist hierarch, now Captain Frazer's lover."@en ;
    schema:disambiguatingDescription "Asks Lewis to interpret her affair with the wordless Frazer and to settle its 'basic matters'; over the following months he follows the relationship through the Capri trip, the break-ups and suicide threats, and her retirement to Ischia 'to deflate' once Frazer is posted away."@en ;
    schema:name "Signora Lola" ;
    schema:url <https://naples44.michelepasin.org/people/signora-lola/> .

place:afragola a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Afragola is a city and comune (municipality) in the Metropolitan City of Naples in the region of Campania in southern Italy. It has 61,581 inhabitants."@en ;
    schema:disambiguatingDescription "One of the small towns ringing Naples that Lewis polices, standing in for the poor, Camorra-shadowed hinterland just beyond the city. It recurs around denunciations, vendettas, wire-theft prosecutions and the bandit Domenico ‘Lupo’."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.91666667 ;
            schema:longitude 14.31666667 ] ;
    schema:name "Afragola" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Afragola> ;
    schema:url <https://naples44.michelepasin.org/places/afragola/> .

theme:disease_health a schema:DefinedTerm ;
    schema:description "Illness, hospitals, epidemics, medical matters"@en ;
    schema:inDefinedTermSet id:themes ;
    schema:name "Disease & health" ;
    schema:url <https://naples44.michelepasin.org/themes/disease_health/> .

place:salerno a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Salerno is a city and comune in Campania, southern Italy, and the capital of the province of the same name. With 125,958 inhabitants as of 2025, it is the second most populous municipality in the region after Naples. The city lies on the Gulf of Salerno, on the Tyrrhenian Sea."@en ;
    schema:disambiguatingDescription "The invasion beachhead where the book opens. Lewis lands nearby in September 1943 into chaos — a German counter-attack, gas scares, rumours the beachhead will be abandoned — and the town stays a reference point for the campaign's uncertain first weeks."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.6806 ;
            schema:longitude 14.7594 ] ;
    schema:name "Salerno" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Salerno> ;
    schema:url <https://naples44.michelepasin.org/places/salerno/> .

id:themes a schema:DefinedTermSet ;
    schema:name "Naples '44 themes" .

person:vincente-lattarullo a schema:Person ;
    schema:additionalType "Informant / contact" ;
    schema:description "One of Naples's four thousand briefless lawyers — 'distinguished, fragile-looking' and slowly starving; 'motivated', he says, 'by a passion for justice'."@en ;
    schema:disambiguatingDescription "Lewis's 'prize acquisition' among his civilian contacts and, more than that, his window onto the city: the borrowed-furniture lunch, the sideline as a hired 'uncle from Rome' at funerals, and his complete ignorance of the vendetta country ten miles from his café all become set-pieces of the book."@en ;
    schema:name "Vincente Lattarullo" ;
    schema:url <https://naples44.michelepasin.org/people/vincente-lattarullo/> .

folklore:san-gennaro a schema:DefinedTerm ;
    schema:description "Januarius, also known as Januarius I of Benevento, was Bishop of Benevento and is a martyr and saint of the Catholic Church. While no contemporary sources on his life are preserved, later sources and legends say he died during the Great Persecution, which ended with Diocletian's retirement in 305."@en ;
    schema:disambiguatingDescription "The patron of Naples, whose dried blood is expected to liquefy on his feast days; the wartime vigils over whether — and how fast — the miracle happens run through the book as a barometer of public nerves, and his rivalry with San Sebastiano flares during the eruption, when his image is smuggled to San Sebastiano 'on an outside chance'."@en ;
    schema:inDefinedTermSet id:folklore ;
    schema:name "San Gennaro" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Januarius> ;
    schema:url <https://naples44.michelepasin.org/folklore/san-gennaro/> .

person:captain-frazer a schema:Person ;
    schema:additionalType "Allied colleague" ;
    schema:description "A tall, handsome RASC captain whose hands are on military supplies."@en ;
    schema:disambiguatingDescription "Lola's lover; Lewis is roped in to interpret for the couple and becomes a bemused witness to the whole affair — the white-bread courtship, Frazer's health wrecked by Lola's demands, the golden Capri outing, the break-ups and reconciliations, and finally his posting away."@en ;
    schema:name "Captain Frazer" ;
    schema:url <https://naples44.michelepasin.org/people/captain-frazer/> .

place:benevento a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Benevento is a city and comune (municipality) of Campania, Italy, capital of the province of Benevento. It is situated on a hill 130 metres above sea level at the confluence of the Calore Irpino and the Sabato. As of June 30, 2025, Benevento has 55,319 inhabitants."@en ;
    schema:disambiguatingDescription "Where Lewis is posted, alone, in August 1944 to run security for a city wrecked by an air raid and sunk in near-universal mourning. His weeks here are dominated by typhus and typhoid, the arrival of undisciplined Canadian troops, and an escalating, dangerous campaign against motorised bandits."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 41.13333333 ;
            schema:longitude 14.78333333 ] ;
    schema:name "Benevento" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Benevento> ;
    schema:url <https://naples44.michelepasin.org/places/benevento/> .

place:rome a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Rome is the capital city and most populated comune (municipality) of Italy. It is also the administrative centre of the Lazio region and of the Metropolitan City of Rome. A special comune named Roma Capitale with a population of 2.7 million in an area of 1,287.36 km2 (497.1 mi2), Rome is the third most populous city in the European Union by population within city limits."@en ;
    schema:disambiguatingDescription "Mostly referred to rather than visited: ‘the fall of Rome’, an internee escorted there for interrogation, Lattarullo's funeral-mourning trade reviving once the city falls. It marks the war moving north, away from Naples."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 41.89333333 ;
            schema:longitude 12.48277778 ] ;
    schema:name "Rome" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Rome> ;
    schema:url <https://naples44.michelepasin.org/places/rome/> .

