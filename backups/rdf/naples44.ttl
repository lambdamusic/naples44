    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "local Carabinieri marshal in Benevento; later suspected via an anonymous letter of involvement with one of the bandit gangs"@en ;
            schema:mentions person:marshal-altamura ],
        person:marshal-altamura ;
    schema:name "August 20, 1944" ;
    schema:position 89 ;
    schema:url <https://naples44.michelepasin.org/entries/88/> .

entry:9 a schema:Chapter ;
    schema:about theme:war_violence ;
    schema:abstract "An account of a botched American paratroop drop, followed by the grim sight of German tank crews killed in their vehicles."@en ;
    schema:contentLocation place:avellino,
        place:battipaglia,
        place:sele-river ;
    schema:dateCreated "1943-09-18"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 18, 1943" ;
    schema:position 10 ;
    schema:url <https://naples44.michelepasin.org/entries/9/> .

entry:90 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:crime_banditry ;
    schema:abstract "A grenade attack on an MP sergeant prompts a tense but ultimately toothless conference about how to respond to the now-motorized bandits."@en ;
    schema:contentLocation place:nola ;
    schema:dateCreated "1944-08-25"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "August 25, 1944" ;
    schema:position 91 ;
    schema:url <https://naples44.michelepasin.org/entries/90/> .

entry:91 a schema:Chapter ;
    schema:about theme:disease_health ;
    schema:abstract "Amid outbreaks of typhoid, smallpox, and typhus in Benevento, the local Marshal remarks darkly on outsiders' inability to survive the harsh conditions."@en ;
    schema:contentLocation place:benevento,
        place:rome ;
    schema:dateCreated "1944-08-28"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "August 28, 1944" ;
    schema:position 92 ;
    schema:url <https://naples44.michelepasin.org/entries/91/> .

entry:93 a schema:Chapter ;
    schema:about theme:allied_conduct,
        theme:disease_health ;
    schema:abstract "Delivering the medicine, Lewis witnesses a bloody mourning ritual, a chaotic anti-typhus spraying operation, and the arrival of freewheeling Canadian troops."@en ;
    schema:contentLocation place:benevento ;
    schema:dateCreated "1944-08-31"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "August 31, 1944" ;
    schema:position 94 ;
    schema:url <https://naples44.michelepasin.org/entries/93/> .

entry:94 a schema:Chapter ;
    schema:about theme:allied_conduct ;
    schema:abstract "The newly-arrived Canadian soldiers prove restless, undisciplined, and utterly disconnected from the war and the local population around them."@en ;
    schema:contentLocation place:avellino,
        place:benevento,
        place:hotel-vesuvio-benevento ;
    schema:dateCreated "1944-09-01"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 1, 1944" ;
    schema:position 95 ;
    schema:url <https://naples44.michelepasin.org/entries/94/> .

entry:95 a schema:Chapter ;
    schema:about theme:superstition_religion ;
    schema:abstract "Following Don Ubaldo's death, the section relocates to a remote, archaic hill village with its own strange local fox-cult ritual."@en ;
    schema:contentLocation place:sagranella ;
    schema:dateCreated "1944-09-03"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "an annual fox burned as ritual, its tail hung at the village entrance"@en ;
            schema:mentions folklore:sagranella-fox-cult ],
        [ a schema:Role ;
            schema:description "dies of typhoid"@en ;
            schema:mentions person:don-ubaldo ],
        [ a schema:Role ;
            schema:description "reported to be practised as a matter of course on the neighbouring estate, where the steward is said to feel a prospective female worker's muscles before employing her"@en ;
            schema:mentions folklore:droit-du-seigneur-sagranella ],
        folklore:droit-du-seigneur-sagranella,
        folklore:sagranella-fox-cult,
        person:don-ubaldo ;
    schema:name "September 3, 1944" ;
    schema:position 96 ;
    schema:url <https://naples44.michelepasin.org/entries/95/> .

entry:96 a schema:Chapter ;
    schema:about theme:allied_conduct,
        theme:bureaucracy_absurdity ;
    schema:abstract "The generous but reckless Canadians treat everything, including two local girls they've picked up, with careless ease; Lewis is assigned to probe a clandestine political party."@en ;
    schema:contentLocation place:benevento,
        place:campobasso,
        place:monti-del-sannio,
        place:sagranella,
        place:san-marco-di-cavali ;
    schema:dateCreated "1944-09-06"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 6, 1944" ;
    schema:position 97 ;
    schema:url <https://naples44.michelepasin.org/entries/96/> .

entry:98 a schema:Chapter ;
    schema:about theme:crime_banditry,
        theme:war_violence ;
    schema:abstract "A section colleague is shot and wounded by a bandit disguised as an American officer, forcing Lewis to weigh his own role in the anti-bandit effort."@en ;
    schema:contentLocation place:altamura,
        place:avellino,
        place:benevento ;
    schema:dateCreated "1944-09-16"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "the section's first casualty, wounded by a bandit disguised as an American officer"@en ;
            schema:mentions person:bernard-durham ],
        [ a schema:Role ;
            schema:description "Lewis grows increasingly uneasy about his alliance with the marshal amid suspicions of bandit collusion"@en ;
            schema:mentions person:marshal-altamura ],
        person:bernard-durham,
        person:marshal-altamura ;
    schema:name "September 16, 1944" ;
    schema:position 99 ;
    schema:url <https://naples44.michelepasin.org/entries/98/> .

entry:99 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:crime_banditry ;
    schema:abstract "A tense overnight checkpoint operation against suspected bandit traffic is set up on a lonely road, staffed by a poorly coordinated mix of Allied and Italian forces."@en ;
    schema:contentLocation place:benevento,
        place:ufita-river ;
    schema:dateCreated "1944-09-19"^^xsd:date ;
    schema:isPartOf id:naples-44 ;
    schema:name "September 19, 1944" ;
    schema:position 100 ;
    schema:url <https://naples44.michelepasin.org/entries/99/> .

event:1 a schema:Event ;
    schema:additionalType "Global" ;
    schema:description "Germany invades Poland, triggering Britain and France's declarations of war and the start of the Second World War in Europe."@en ;
    schema:name "WWII begins" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Invasion_of_Poland> ;
    schema:startDate "1939-09-01"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:10 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Allied bombers destroy the historic Benedictine abbey at Monte Cassino, believing (wrongly, it later emerged) that German troops were using it."@en ;
    schema:name "Bombing of Monte Cassino abbey" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Battle_of_Monte_Cassino> ;
    schema:startDate "1944-02-15"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:11 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Polish II Corps troops raise their flag over the ruins of Monte Cassino after four months of battle, finally breaking the Gustav Line and opening the road to Rome."@en ;
    schema:name "Monte Cassino falls / Gustav Line broken" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Battle_of_Monte_Cassino> ;
    schema:startDate "1944-05-18"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:12 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "US Fifth Army enters Rome, the first Axis capital to fall to the Allies."@en ;
    schema:name "Rome liberated" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Liberation_of_Rome> ;
    schema:startDate "1944-06-04"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:13 a schema:Event ;
    schema:additionalType "Global" ;
    schema:description "Allied forces land in Normandy, opening the Western Front in France — coming two days after Rome's liberation, it quickly overshadowed that achievement in the wider war narrative."@en ;
    schema:name "D-Day — Normandy landings" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Normandy_landings> ;
    schema:startDate "1944-06-06"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:14 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Allied troops and Italian partisans complete the liberation of Florence after the Germans destroyed the city's bridges (sparing only the Ponte Vecchio) during their retreat."@en ;
    schema:name "Florence liberated" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Battle_of_Florence> ;
    schema:startDate "1944-08-11"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:15 a schema:Event ;
    schema:additionalType "Global" ;
    schema:description "Allied forces land in southern France, a landing that drew significant troop strength away from the Italian campaign."@en ;
    schema:name "Operation Dragoon — invasion of southern France" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Operation_Dragoon> ;
    schema:startDate "1944-08-15"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:16 a schema:Event ;
    schema:additionalType "Global" ;
    schema:description "Allied forces and the French Resistance liberate Paris from German occupation."@en ;
    schema:name "Paris liberated" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Liberation_of_Paris> ;
    schema:startDate "1944-08-25"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:17 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "The Allies launch their first major assault on the Gothic Line, the Germans' last major defensive line in the northern Apennines."@en ;
    schema:name "Gothic Line offensive begins (Operation Olive)" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Operation_Olive> ;
    schema:startDate "1944-08-25"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:18 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Mussolini is captured by Italian partisans while attempting to flee to Switzerland and is executed the following day."@en ;
    schema:name "Mussolini captured and executed" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Death_of_Benito_Mussolini> ;
    schema:startDate "1945-04-28"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:19 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Surrender at Caserta takes effect, ending the Italian campaign — fought in the very city, Caserta, that appears repeatedly in the book's own pages."@en ;
    schema:name "German forces in Italy surrender" ;
    schema:sameAs <https://en.wikipedia.org/wiki/German_instrument_of_surrender_(Caserta)> ;
    schema:startDate "1945-05-02"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:2 a schema:Event ;
    schema:additionalType "Global" ;
    schema:description "Japan's attack on Pearl Harbor brings the United States into the Second World War."@en ;
    schema:name "Pearl Harbor / US enters the war" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Attack_on_Pearl_Harbor> ;
    schema:startDate "1941-12-07"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:20 a schema:Event ;
    schema:additionalType "Global" ;
    schema:description "Germany's unconditional surrender takes effect, ending the Second World War in Europe."@en ;
    schema:name "VE Day — war ends in Europe" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Victory_in_Europe_Day> ;
    schema:startDate "1945-05-08"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:3 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Operation Husky lands Allied forces on Sicily, opening the Italian campaign."@en ;
    schema:name "Allied invasion of Sicily begins" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Allied_invasion_of_Sicily> ;
    schema:startDate "1943-07-10"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:4 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "King Victor Emmanuel III dismisses and arrests Mussolini; Marshal Pietro Badoglio becomes prime minister."@en ;
    schema:name "Mussolini removed from power" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Benito_Mussolini> ;
    schema:startDate "1943-07-25"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:5 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Italy's secret armistice with the Allies (signed Sept 3) is publicly announced, taking Italy out of the war on the Axis side. This is the same news Lewis's unit receives aboard ship in the book's opening entry."@en ;
    schema:name "Armistice of Cassibile announced" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Armistice_of_Cassibile> ;
    schema:startDate "1943-09-08"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:6 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "US Fifth Army lands at Salerno, opening the mainland Italian campaign — the landing Lewis himself takes part in at Paestum the same day."@en ;
    schema:name "Salerno landings (Operation Avalanche)" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Landing_at_Salerno> ;
    schema:startDate "1943-09-09"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:7 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Allied troops enter Naples after the Four Days of Naples uprising against the German garrison."@en ;
    schema:name "Naples liberated" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Four_days_of_Naples> ;
    schema:startDate "1943-10-01"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:8 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Fifth Army begins crossing the Volturno River north of Naples, the first of a series of offensives pushing toward the Gustav Line."@en ;
    schema:name "Volturno Line offensive begins" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Battle_of_the_Volturno_Line> ;
    schema:startDate "1943-10-12"^^xsd:date ;
    schema:superEvent id:world-war-ii .

event:9 a schema:Event ;
    schema:additionalType "Italian campaign" ;
    schema:description "Allied forces land at Anzio, south of Rome, hoping to outflank the Gustav Line — the landing Lewis reports on in the book via a security leak he is sent to trace."@en ;
    schema:name "Anzio landings (Operation Shingle)" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Battle_of_Anzio> ;
    schema:startDate "1944-01-22"^^xsd:date ;
    schema:superEvent id:world-war-ii .

entry:100 a schema:Chapter ;
    schema:about theme:crime_banditry,
        theme:personal_reflection ;
    schema:abstract "A search for confiscated goods turns up little, and Lewis senses a cooling, more guarded attitude from the Marshal and townspeople toward him. He reflects that what he'd been treating as bribery may really be a customary, expected exchange of courtesy gifts — and that his own rigid refusal of it has cost him local goodwill."@en ;
    schema:dateCreated "1944-09-20"^^xsd:date ;
    schema:hasPart reflection:66 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "local farmer arrested for sheltering a wounded bandit; his arrest meets with general disapproval among townspeople"@en ;
            schema:mentions person:de-micco ],
        person:de-micco ;
    schema:name "September 20, 1944" ;
    schema:position 101 ;
    schema:url <https://naples44.michelepasin.org/entries/100/> .

entry:101 a schema:Chapter ;
    schema:about theme:personal_reflection,
        theme:superstition_religion ;
    schema:abstract "Lewis realizes with unease that locals now regard him as a possible *jettatore* (bearer of the evil eye), noting superstitious gestures made in his presence. He then reflects that a year after liberation, still hungry and diseased amid lawless ruins with only the distant promise of corrupt democracy ahead, Neapolitans may reasonably look back on the Mussolini years as a lost paradise by comparison."@en ;
    schema:contentLocation place:hotel-vesuvio-benevento,
        place:sagranella ;
    schema:dateCreated "1944-09-23"^^xsd:date ;
    schema:hasPart reflection:67 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "jettatore superstition; protective gestures made against Lewis himself"@en ;
            schema:mentions folklore:evil-eye ],
        folklore:evil-eye ;
    schema:name "September 23, 1944" ;
    schema:position 102 ;
    schema:url <https://naples44.michelepasin.org/entries/101/> .

entry:102 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:personal_reflection ;
    schema:abstract "A reunion with an old colleague who has become almost entirely assimilated into Southern Italian life prompts reflection on how deeply the region changes people."@en ;
    schema:contentLocation place:altamura,
        place:bari,
        place:benevento,
        place:corso-umberto,
        place:sicily,
        place:tunisia ;
    schema:dateCreated "1944-09-25"^^xsd:date ;
    schema:hasPart reflection:68 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "old colleague from Tunisia, reunited after eighteen months, visibly transformed by Southern Italy"@en ;
            schema:mentions person:neil-armstrong ],
        person:neil-armstrong ;
    schema:name "September 25, 1944" ;
    schema:position 103 ;
    schema:url <https://naples44.michelepasin.org/entries/102/> .

entry:103 a schema:Chapter ;
    schema:about theme:disease_health,
        theme:personal_reflection,
        theme:war_violence ;
    schema:abstract "Back in Naples, Lewis finds the section overworked, understaffed, and increasingly worn down by illness after months of dispersal. He reflects that the strange fascination of the intelligence work itself — a kind of legalised eavesdropping on humanity — is what keeps him working dangerously long hours despite the toll."@en ;
    schema:contentLocation place:altamura,
        place:benevento,
        place:ischia,
        place:rome ;
    schema:dateCreated "1944-10-06"^^xsd:date ;
    schema:hasPart reflection:69 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "sick with hepatitis"@en ;
            schema:mentions person:moore ],
        person:moore ;
    schema:name "October 6, 1944" ;
    schema:position 104 ;
    schema:url <https://naples44.michelepasin.org/entries/103/> .

entry:108 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:personal_reflection ;
    schema:abstract "Lewis is abruptly ordered to a new mission repatriating Russian ex-POWs, sensing this marks the end of his time in Naples."@en ;
    schema:contentLocation place:calabritto-palace,
        place:khorramshahr,
        place:persian-gulf,
        place:port-said,
        place:red-sea,
        place:sicily,
        place:taranto,
        place:vesuvius,
        place:villa-floridiana,
        place:vomero-naples ;
    schema:dateCreated "1944-10-24"^^xsd:date ;
    schema:hasPart reflection:70 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "a woman's ritualized gesture interpreted as an offering to a fertility deity"@en ;
            schema:mentions folklore:fertility-offering-superstition ],
        folklore:fertility-offering-superstition ;
    schema:name "October 24, 1944" ;
    schema:position 109 ;
    schema:url <https://naples44.michelepasin.org/entries/108/> .

entry:15 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:war_violence ;
    schema:abstract "Arriving in a ruined, waterless Naples, the section settles into a grand requisitioned palazzo on the Riviera di Chiaia."@en ;
    schema:contentLocation place:nola,
        place:palace-of-the-princes-of-satriano,
        place:piazza-vittoria,
        place:questura-naples-police-hq,
        place:riviera-di-chiaia,
        place:sorrento ;
    schema:dateCreated "1943-10-06"^^xsd:date ;
    schema:hasPart reflection:38 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "best Italian speaker, sent as a solitary exile to Nola"@en ;
            schema:mentions person:eric-williams ],
        [ a schema:Role ;
            schema:description "section member"@en ;
            schema:mentions person:bernard-durham ],
        [ a schema:Role ;
            schema:description "section member"@en ;
            schema:mentions person:evans ],
        [ a schema:Role ;
            schema:description "section member, deals with Naples's doctors"@en ;
            schema:mentions person:robert-parkinson ],
        person:bernard-durham,
        person:eric-williams,
        person:evans,
        person:robert-parkinson ;
    schema:name "October 6, 1943" ;
    schema:position 16 ;
    schema:url <https://naples44.michelepasin.org/entries/15/> .

entry:2 a schema:Chapter ;
    schema:about theme:war_violence ;
    schema:abstract "Landing at Paestum amid dead soldiers and eerie calm; the section is left rudderless, with no briefing, next to the ancient temples."@en ;
    schema:contentLocation place:oran,
        place:paestum ;
    schema:dateCreated "1943-09-09"^^xsd:date ;
    schema:hasPart reflection:36 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "Field Security Officer, injured in a car crash before embarkation"@en ;
            schema:mentions person:captain-cartwright ],
        person:captain-cartwright ;
    schema:name "September 9, 1943" ;
    schema:position 3 ;
    schema:url <https://naples44.michelepasin.org/entries/2/> .

entry:20 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:poverty_hunger ;
    schema:abstract "Introduction of Vincente Lattarullo, an eccentric, impoverished informant obsessed with justice and etiquette, who becomes a key civilian contact."@en ;
    schema:contentLocation place:bar-vittoria,
        place:bari,
        place:rome,
        place:taranto ;
    schema:dateCreated "1943-10-15"^^xsd:date ;
    schema:hasPart reflection:39 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "starving non-practising Naples lawyer, Lewis's prize civilian contact; moved by a 'passion for justice'"@en ;
            schema:mentions person:vincente-lattarullo ],
        [ a schema:Role ;
            schema:description "hired-mourner funeral custom — a well-dressed stranger poses as a dignified 'uncle from Rome' to add prestige to a family's funeral display"@en ;
            schema:mentions folklore:zio-di-roma ],
        folklore:zio-di-roma,
        person:vincente-lattarullo ;
    schema:name "October 15, 1943" ;
    schema:position 21 ;
    schema:url <https://naples44.michelepasin.org/entries/20/> .

entry:23 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:war_violence ;
    schema:abstract "A false tip about mass delayed-action mines triggers a chaotic mass evacuation of Naples, including hospital patients and the bedridden."@en ;
    schema:contentLocation place:fontanelle-naples,
        place:vomero-naples ;
    schema:dateCreated "1943-10-23"^^xsd:date ;
    schema:hasPart reflection:40 ;
    schema:isPartOf id:naples-44 ;
    schema:name "October 23, 1943" ;
    schema:position 24 ;
    schema:url <https://naples44.michelepasin.org/entries/23/> .

entry:24 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:war_violence ;
    schema:abstract "Lewis is sent to investigate whether the German soldier behind the mine hoax should be executed as a spy."@en ;
    schema:contentLocation place:philippeville,
        place:poggio-reale-prison ;
    schema:dateCreated "1943-10-24"^^xsd:date ;
    schema:hasPart reflection:41 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "young Italian-German soldier behind the mine hoax; Lewis reports him mentally unbalanced to spare him execution"@en ;
            schema:mentions person:sauro ],
        person:sauro ;
    schema:name "October 24, 1943" ;
    schema:position 25 ;
    schema:url <https://naples44.michelepasin.org/entries/24/> .

entry:27 a schema:Chapter ;
    schema:about theme:bureaucracy_absurdity,
        theme:personal_reflection ;
    schema:abstract "Lewis is indignant at the drastic cut to informant funds, arguing money isn't really what motivates their most dedicated Italian contacts."@en ;
    schema:contentLocation place:vico-chiatamone,
        place:vomero-naples ;
    schema:dateCreated "1943-11-01"^^xsd:date ;
    schema:hasPart reflection:42 ;
    schema:isPartOf id:naples-44 ;
    schema:mentions [ a schema:Role ;
            schema:description "reports on black-market corruption; Lewis witnesses his desperate poverty and the blind orphan girls scene with him"@en ;
            schema:mentions person:vincente-lattarullo ],
        [ a schema:Role ;
            schema:description "brings news of reduced informant funds"@en ;
            schema:mentions person:sergeant-major-john-dashwood ],
        [ a schema:Role ;
            schema:description "hunchbacks are considered lucky in Naples; lottery-ticket buyers touch or stroke a hunchback's hump as part of the purchase"@en ;
            schema:mentions folklore:hunchbacks-as-luck-bringers ],
