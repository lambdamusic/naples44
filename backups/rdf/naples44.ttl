    schema:additionalType "Town" ;
    schema:description "Pompeii was a city in what is now the municipality of Pompei, near Naples, in the Campania region of Italy. Along with Herculaneum, Stabiae, and many surrounding villas, it was buried under 4 to 6 m of volcanic ash and pumice in the eruption of Mount Vesuvius in 79 AD."@en ;
    schema:disambiguatingDescription "Invoked again and again as the template for catastrophe: a soldier gives Lewis a scrap of a Pompeii Madonna's mantle as a charm, and during the eruption he sees people frozen in the ash in the postures of the bodies at Pompeii."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.75 ;
            schema:longitude 14.48611111 ] ;
    schema:name "Pompeii" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Pompeii> ;
    schema:url <https://naples44.michelepasin.org/places/pompeii/> .

place:port-said a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Port Said is a port city that lies in northeast Egypt extending about 30 km (19 mi) along the coast of the Mediterranean Sea, straddling the west bank of the northern mouth of the Suez Canal. The city is the capital of the Port Said Governorate and forms the majority of the governorate, comprising seven of the governorate's eight administrative regions. In 2024, it had a population of 790,000 people."@en ;
    schema:disambiguatingDescription "The Egyptian port where Lewis is to embark three thousand Russian ex-POWs for repatriation — the assignment that ends his time in Naples."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 31.2625 ;
            schema:longitude 32.30611111 ] ;
    schema:name "Port Said" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Port_Said> ;
    schema:url <https://naples44.michelepasin.org/places/port-said/> .

place:portici a schema:Place ;
