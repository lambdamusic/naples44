folklore:santa-maria-dintercessione a schema:DefinedTerm ;
    schema:description "A venerated Marian image in Naples."@en ;
    schema:disambiguatingDescription "In the church of Santo Agnello her image holds a 'regular conversation' with a speaking crucifix — 'a fact confirmed by reporters on the spot' — among the talking, bleeding, sweating images multiplying across Naples in spring 1944."@en ;
    schema:inDefinedTermSet id:folklore ;
    schema:name "Santa Maria d'Intercessione" ;
    schema:url <https://naples44.michelepasin.org/folklore/santa-maria-dintercessione/> .

place:agropoli a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Agropoli is a town and comune located in the Cilento area of the province of Salerno, Campania, Italy. It is situated at the start of the Cilentan Coast, on the Tyrrhenian Sea."@en ;
    schema:disambiguatingDescription "A coastal town south of Salerno cited in the newspapers' gleeful catalogue of audacious wartime thefts — here, small ships lifted bodily out of the water and spirited away."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.35 ;
            schema:longitude 14.98333333 ] ;
    schema:name "Agropoli" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Agropoli> ;
    schema:url <https://naples44.michelepasin.org/places/agropoli/> .

place:algeria a schema:Place ;
    schema:additionalType "Region" ;
    schema:description "Algeria, officially the People's Democratic Republic of Algeria, is a country in the Maghreb region of North Africa. Spanning over 2,381,741 square kilometres (919,595 sq mi), it is the largest country in Africa and the tenth largest in the world. It is bordered to the northeast by Tunisia; to the east by Libya; to the southeast by Niger; to the southwest by Mali, Mauritania, and Western Sahara; to the west by Morocco; and to the north by the Mediterranean Sea."@en ;
    schema:disambiguatingDescription "Where Lewis served before Italy; it surfaces only in memory, when he unexpectedly finds a nurse he had known there running the hospital ward holding a captured Italian saboteur."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 28.0 ;
            schema:longitude 2.0 ] ;
    schema:name "Algeria" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Algeria> ;
    schema:url <https://naples44.michelepasin.org/places/algeria/> .

place:altavilla-silentina a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Altavilla Silentina is a town and comune located in the province of Salerno, Campania, some 100 km south of Naples, Italy."@en ;
    schema:disambiguatingDescription "A hill town near Battipaglia that Lewis learns was shelled to rubble on the mere suspicion that it held Germans — an early instance of the campaign's casual destruction of Italian towns."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.5302405 ;
            schema:longitude 15.1310307 ] ;
    schema:name "Altavilla Silentina" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Altavilla_Silentina> ;
    schema:url <https://naples44.michelepasin.org/places/altavilla-silentina/> .

place:amalfi a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Amalfi is a town and comune in the province of Salerno, in the region of Campania, Italy, on the Gulf of Salerno. It lies at the mouth of a deep ravine, at the foot of Monte Cerreto, surrounded by dramatic cliffs and coastal scenery. The town of Amalfi was the capital of the maritime republic known as the Duchy of Amalfi, an important trading power in the Mediterranean between 839 and around 1200."@en ;
    schema:disambiguatingDescription "Appears once, when Lewis drives the folklore writer Del Giudice there to see the thrice-yearly liquefaction of the 'manna' relic of St Andrew — one of the book's studies of Neapolitan religious spectacle."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.63367 ;
            schema:longitude 14.60262 ] ;
    schema:name "Amalfi" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Amalfi> ;
    schema:url <https://naples44.michelepasin.org/places/amalfi/> .

place:baia a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Baiae is an ancient Roman town situated on the northwest shore of the Gulf of Naples and now in the comune of Bacoli. It was a resort for centuries in antiquity, particularly towards the end of the Roman Republic, when it was reckoned as superior to Capri, Pompeii, and Herculaneum by wealthy Romans, who built villas here from 100 BC. Ancient authors attest that many emperors built in Baia, almost in competition with their predecessors, and they and their courts often stayed there."@en ;
    schema:disambiguatingDescription "One of the ancient pleasure-towns on the bay past Pozzuoli, outside the Camorra zone; Lewis visits on his rare tourist day off and dwells on its Roman history of luxury and vice."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 41.3004047 ;
            schema:longitude 14.2513235 ] ;
    schema:name "Baia" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Baiae> ;
    schema:url <https://naples44.michelepasin.org/places/baia/> .

place:bar-vittoria a schema:Place ;
    schema:additionalType "Landmark" ;
    schema:disambiguatingDescription "The bar next door to the section's office where Lewis takes the newly-met Lattarullo for a marsala all'uovo — the encounter that begins their long association."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8564312 ;
            schema:longitude 14.2584991 ] ;
    schema:name "Bar Vittoria" ;
    schema:url <https://naples44.michelepasin.org/places/bar-vittoria/> .

