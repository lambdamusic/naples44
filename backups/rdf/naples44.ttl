place:procida a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Procida is one of the Phlegraean Islands off the coast of Naples in southern Italy. The island is between Cape Miseno and the island of Ischia. With its tiny satellite island of Vivara, it is a comune (municipality) of the Metropolitan City of Naples, in the region of Campania."@en ;
    schema:disambiguatingDescription "The prison island of which 'little but blood-chilling legends' is known, the destination of lifers and of the petty thieves who fill its cells while well-connected racketeers walk free — the book's recurring image of one-sided justice."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.758333 ;
            schema:longitude 14.016667 ] ;
    schema:name "Procida" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Procida> ;
    schema:url <https://naples44.michelepasin.org/places/procida/> .

place:questura-naples-police-hq a schema:Place ;
    schema:additionalType "Landmark" ;
    schema:disambiguatingDescription "Naples police headquarters, where Lewis liaises with the Italian police — on denunciation cases and the messy business of wartime romances."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8388 ;
            schema:longitude 14.2517 ] ;
    schema:name "Questura (Naples police HQ)" ;
    schema:url <https://naples44.michelepasin.org/places/questura-naples-police-hq/> .

place:resina a schema:Place ;
    schema:additionalType "Town" ;
    schema:description "Ercolano is a city and comune (municipality) in the Metropolitan City of Naples in the region of Campania in southern Italy. It lies at the western foot of Mount Vesuvius, on the Gulf of Naples, just southeast of Naples. It has 49,179 inhabitants."@en ;
    schema:disambiguatingDescription "One of the towns below Vesuvius on Lewis's beat, passed through on the road back to Naples and again during the eruption."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8085867 ;
            schema:longitude 14.347367 ] ;
    schema:name "Resina" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Ercolano> ;
    schema:url <https://naples44.michelepasin.org/places/resina/> .

place:sagranella a schema:Place ;
    schema:additionalType "Town" ;
    schema:disambiguatingDescription "The remote hill village — with its ‘strange local fox-cult ritual’ — where the section relocates after Don Ubaldo's death in September 1944, and where Lewis realises with unease that locals take him for a jettatore."@en ;
    schema:name "Sagranella" ;
    schema:url <https://naples44.michelepasin.org/places/sagranella/> .

place:san-carlo-opera-house a schema:Place ;
    schema:additionalType "Landmark" ;
    schema:description "The Real Teatro di San Carlo, as originally named by the Bourbon monarchy but today known simply as the Teatro (di) San Carlo, is a historic opera house in Naples, Italy, connected to the Royal Palace and adjacent to the Piazza del Plebiscito. It is the oldest continuously active venue for opera in the world, having opened in 1737, decades before either Milan's La Scala or Venice's La Fenice."@en ;
    schema:disambiguatingDescription "The opera house where Naples's social life is really conducted; in the book it becomes an emblem of the black market, its reopening-night audience of upper-class women all wearing coats cut from stolen Allied blankets."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.8375 ;
            schema:longitude 14.24944444 ] ;
    schema:name "San Carlo opera house" ;
    schema:sameAs <https://en.wikipedia.org/wiki/Teatro_di_San_Carlo> ;
    schema:url <https://naples44.michelepasin.org/places/san-carlo-opera-house/> .

place:sele-river a schema:Place ;
    schema:additionalType "Natural feature" ;
    schema:disambiguatingDescription "The river by the Salerno beachhead, where HQ sits through the tense, underdefended first days and the night battles of September 1943."@en ;
    schema:geo [ a schema:GeoCoordinates ;
            schema:latitude 40.6103067 ;
            schema:longitude 15.1436047 ] ;
    schema:name "Sele river" ;
    schema:url <https://naples44.michelepasin.org/places/sele-river/> .

