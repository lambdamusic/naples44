entry:45 a schema:Chapter ;
    schema:about theme:naples_character,
        theme:personal_reflection ;
    schema:abstract "Lewis reflects on the cultural gulf between cosmopolitan Naples and the archaic, vendetta-bound countryside just miles away, as seen through Lattarullo's ignorance of it."@en ;
