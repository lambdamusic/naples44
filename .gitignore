# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
*.egg-info/

# Unit test / coverage reports
.coverage
htmlcov/

# Django stuff
*.log
collectstatic/

# virtualenv
.venv
venv/
ENV/

# misc
.vscode/
.DS_Store

# disposable wget mirror target — regenerated by tools/site-dump every run
build/

# PRIVATE / LOCAL-ONLY FILES — do not commit
local_settings.py
db.sqlite3
tools/db-bootstrap
README_PRIVATE.md

# source dataset — one-time seed only; backups/django/dump.json is the committed source
plan-files/

# The maintainer's backlog: kept locally, out of the public repo. On their machine this
# is a symlink into Dropbox (the central backlog folder), hence no trailing slash.
/backlog
